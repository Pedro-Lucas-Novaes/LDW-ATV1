  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nome": {
            "type": "string",
            "example": "Ana Silva"
          },
          "email": {
            "type": "string",
            "example": "ana.silva@email.com"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-13T10:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-13T10:00:00.000Z"
          }
        }
      },
      "CreateUserDTO": {
        "type": "object",
        "required": ["nome", "email", "password"],
        "properties": {
          "nome": {
            "type": "string",
            "example": "Ana Silva"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ana.silva@email.com"
          },
          "password": {
            "type": "string",
            "example": "123456"
          }
        }
      },
      "UpdateUserDTO": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "Ana Silva Atualizada"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ana.novo@email.com"
          }
        }
      },
      "LoginDTO": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "ana.silva@email.com"
          },
          "password": {
            "type": "string",
            "example": "123456"
          }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nome": {
            "type": "string",
            "example": "Projeto Faculdade"
          },
          "descricao": {
            "type": "string",
            "nullable": true,
            "example": "Organizacao das atividades da faculdade"
          },
          "user_id": {
            "type": "integer",
            "example": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateProjectDTO": {
        "type": "object",
        "required": ["nome"],
        "properties": {
          "nome": {
            "type": "string",
            "example": "Projeto Faculdade"
          },
          "descricao": {
            "type": "string",
            "example": "Organizacao das atividades da faculdade"
          }
        }
      },
      "UpdateProjectDTO": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "Projeto Faculdade Atualizado"
          },
          "descricao": {
            "type": "string",
            "example": "Nova descricao do projeto"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "titulo": {
            "type": "string",
            "example": "Finalizar atividade de LDW"
          },
          "descricao": {
            "type": "string",
            "nullable": true,
            "example": "Finalizar API do Task Tracker"
          },
          "status": {
            "type": "string",
            "enum": ["pendente", "em_andamento", "concluida"],
            "example": "pendente"
          },
          "prioridade": {
            "type": "string",
            "enum": ["baixa", "media", "alta"],
            "example": "alta"
          },
          "project_id": {
            "type": "integer",
            "example": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateTaskDTO": {
        "type": "object",
        "required": ["titulo", "project_id"],
        "properties": {
          "titulo": {
            "type": "string",
            "example": "Finalizar atividade de LDW"
          },
          "descricao": {
            "type": "string",
            "example": "Finalizar API do Task Tracker"
          },
          "status": {
            "type": "string",
            "enum": ["pendente", "em_andamento", "concluida"],
            "default": "pendente",
            "example": "pendente"
          },
          "prioridade": {
            "type": "string",
            "enum": ["baixa", "media", "alta"],
            "default": "media",
            "example": "alta"
          },
          "project_id": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "UpdateTaskDTO": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "example": "Finalizar atividade de LDW"
          },
          "descricao": {
            "type": "string",
            "example": "API finalizada e testada"
          },
          "status": {
            "type": "string",
            "enum": ["pendente", "em_andamento", "concluida"],
            "example": "concluida"
          },
          "prioridade": {
            "type": "string",
            "enum": ["baixa", "media", "alta"],
            "example": "alta"
          },
          "project_id": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "erro": {
            "type": "string",
            "example": "Requisicao invalida"
          }
        }
      },
      "ErrorDetailResponse": {
        "type": "object",
        "properties": {
          "erro": {
            "type": "string",
            "example": "Erro ao processar a requisicao"
          },
          "detalhe": {
            "type": "string",
            "example": "Descricao tecnica do erro"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "mensagem": {
            "type": "string",
            "example": "Login realizado com sucesso!"
          },
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        }
      }
    }
  }
}
